{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Enrichers.Environment" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": {
      "Console": {
        "Name": "Console"
      },
      "File": {
        "Name": "File",
        "Args": {
          "path": "logs/el3yada-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "el3yada-api"
    }
  },
  "Jwt": {
    "Issuer": "el3yada-api",
    "Audience": "el3yada-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "PasswordResetTokenMinutes": 60,
    "EmailVerificationTokenHours": 48,
    "VerificationEmailCooldownSeconds": 60,
    "AccountSelectionMinutes": 5,
    "UserStateCacheSeconds": 30
  },
  "RateLimits": {
    "LoginPerMinute": 10,
    "PasswordResetPer15Minutes": 5,
    "PasswordResetPerIdentifierPerHour": 3,
    "RegistrationPerHour": 10,
    "RefreshPerMinute": 60,
    "EmailTokenPer15Minutes": 20
  },
  "Email": {
    "Delivery": "Smtp",
    "FromName": "el3yada",
    "Smtp": {
      "Port": 587,
      "Security": "StartTls"
    }
  },
  "Storage": {
    "MaxUploadMb": 200,
    "ThumbnailMaxPx": 320
  },
  "AllowedHosts": "*"
}
