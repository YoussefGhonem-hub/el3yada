@El3yada.Api_HostAddress = https://localhost:7001

# Run in order. Paste the accessToken and refreshToken from the login answer below.
@accessToken = paste-here
@refreshToken = paste-here

GET {{El3yada.Api_HostAddress}}/api/health
Accept: application/json

### Development only: create the demo data (idempotent)
POST {{El3yada.Api_HostAddress}}/api/dev/seed

### Development only: a token for a demo user (until Phase 1 login exists)
# @name patientToken
POST {{El3yada.Api_HostAddress}}/api/dev/token
Content-Type: application/json

{ "identifier": "01000000002", "role": "patient" }

###

GET {{El3yada.Api_HostAddress}}/api/settings/public
Accept: application/json

###

GET {{El3yada.Api_HostAddress}}/api/specialties
Accept: application/json

###

# The super admin from `dotnet run --project src/El3yada.Api -- seed-admin <email>`.
POST {{El3yada.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "identifier": "admin@el3yada.dev",
  "password": "temporary-password-printed-by-seed-admin",
  "device": { "deviceId": "rest-client", "platform": "windows", "appVersion": "0.1.0" }
}

###

GET {{El3yada.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{accessToken}}

###

POST {{El3yada.Api_HostAddress}}/api/auth/setNewPassword
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "newPassword": "MyNewPassw0rd" }

###

POST {{El3yada.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

###

GET {{El3yada.Api_HostAddress}}/api/admin/doctorRegistrations
Authorization: Bearer {{accessToken}}

###

GET {{El3yada.Api_HostAddress}}/api/admin/settings
Authorization: Bearer {{accessToken}}

###

POST {{El3yada.Api_HostAddress}}/api/auth/logout
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}", "deviceId": "rest-client" }

###
@patient = Bearer {{patientToken.response.body.$.accessToken}}

GET {{El3yada.Api_HostAddress}}/api/patient/home
Authorization: {{patient}}

###
GET {{El3yada.Api_HostAddress}}/api/patient/doctors
Authorization: {{patient}}

###
GET {{El3yada.Api_HostAddress}}/api/patient/visits?page=1&pageSize=25
Authorization: {{patient}}

###
GET {{El3yada.Api_HostAddress}}/api/patient/prescriptions?kind=medication
Authorization: {{patient}}

###
GET {{El3yada.Api_HostAddress}}/api/patient/records?kind=lab
Authorization: {{patient}}

###
GET {{El3yada.Api_HostAddress}}/api/patient/medical-profile
Authorization: {{patient}}

### Development only: admin token
# @name adminToken
POST {{El3yada.Api_HostAddress}}/api/dev/token
Content-Type: application/json

{ "identifier": "admin@el3yada.dev" }

###
GET {{El3yada.Api_HostAddress}}/api/admin/accounts?phone=01000000002
Authorization: Bearer {{adminToken.response.body.$.accessToken}}

###
GET {{El3yada.Api_HostAddress}}/api/admin/deletion-requests?status=pending
Authorization: Bearer {{adminToken.response.body.$.accessToken}}
